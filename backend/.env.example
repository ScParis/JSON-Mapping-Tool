# Chave de API do Google Gemini (obrigatória para o Universal Studio Pro e AI Research)
API_KEY=sua_chave_aqui

# Porta em que o backend sobe. Em produção (Koyeb, etc.) o provedor define automaticamente.
PORT=3001

# Origens permitidas para CORS, separadas por vírgula (sem barra no final).
# Em produção, coloque a URL do seu frontend na Vercel.
# Ex.: ALLOWED_ORIGINS=https://meu-app.vercel.app,http://localhost:5173
# ATENÇÃO: se ficar vazio, o backend libera qualquer origem (inseguro fora do dev local).
ALLOWED_ORIGINS=

# Túnel de desenvolvimento (Cloudflare). Só faz sentido rodando localmente.
# Em produção o backend já é público, então deixe FALSE (ou não defina).
# Local (para testar webhooks externos apontando para sua máquina): ENABLE_TUNNEL=true
ENABLE_TUNNEL=false
